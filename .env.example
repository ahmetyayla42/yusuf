# ---- 2Kat Medya Panel · Ortam Değişkenleri ----
# Bu dosyayı ".env" olarak kopyalayıp değerleri doldur.
# .env dosyası repoya YÜKLENMEZ (gizli bilgiler).

# PostgreSQL bağlantı adresi.
# Neon (ücretsiz) veya Vercel Postgres'ten alacaksın. Örn:
# postgresql://kullanici:sifre@host/veritabani?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/katmedya?schema=public"

# Oturum çerezlerini imzalamak için gizli anahtar (en az 32 karakter).
# Oluşturmak için terminalde:  openssl rand -base64 32
AUTH_SECRET="buraya-en-az-32-karakterlik-rastgele-bir-anahtar-koy"

# İlk admin şifresi (seed çalışırken bu değerle admin oluşturulur).
# Deploy sonrası panelden değiştirebilirsin.
ADMIN_PASSWORD="2katadmin2026"
